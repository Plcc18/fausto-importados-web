# URL base da API (backend)
VITE_API_URL=http://localhost:8080

# Rotas /auth/* (login, refresh, logout) na MESMA origem do front, via proxy da Vercel (vercel.json).
# Obrigatório em produção: o cookie de refresh é SameSite=Strict e Vercel/Render são sites diferentes.
# Em desenvolvimento deixe ausente (localhost:5173 e localhost:8080 são o mesmo site).
# VITE_AUTH_SAME_ORIGIN=true

# Tempo sem interação (ms) após o qual a sessão deixa de ser renovada. Padrão: 7 dias (604800000).
# VITE_IDLE_TIMEOUT_MS=604800000

# Número do WhatsApp da loja (DDI + DDD + número, apenas dígitos)
VITE_WHATSAPP_NUMBER=5585994185637